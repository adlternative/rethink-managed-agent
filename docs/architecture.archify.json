        "focus": [
          "client",
          "api",
          "runs",
          "runner",
          "docker"
        ],
        "note": "A user message is enqueued by the API; a runner claims it and executes the pi loop, with tools running in a leased sandbox."
      },
      {
        "id": "state",
        "label": "State: events and workspaces",
        "focus": [
          "api",
          "postgres",
          "runner",
          "workspaces"
        ],
        "note": "The events table is the only truth; the workspace volume persists file state, and the sandbox can be dropped at any time."
      },
      {
        "id": "realtime",
        "label": "Realtime: streaming and control",
        "focus": [
          "api",
          "redis",
          "runner"
        ],
        "note": "SSE deltas, the steer queue, interrupt signals and heartbeats all go through Redis."
      }
