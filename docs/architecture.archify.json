  "cards": [
    {
      "dot": "cyan",
      "title": "API layer",
      "items": [
        "Aligned with Claude Managed Agents: agents / environments / sessions / events",
        "SSE replays the DB first, then subscribes to Redis, deduped by seq"
      ]
    },
    {
      "dot": "emerald",
      "title": "Thin harness",
      "items": [
        "pi-agent-core's loop plus plugin hooks; plugins run in a restricted host process",
        "The events table is the only truth; session state is the fold of events",
        "Multiple runner replicas share load via a consumer group and row locks"
      ]
    },
    {
      "dot": "violet",
      "title": "Sandbox decoupling",
      "items": [
        "A session does not hold a sandbox; it leases one lazily on the first tool call",
        "Sessions on the same workspace reuse a container via affinity",
        "At the end of a turn state is captured to the workspace volume; the sandbox can be destroyed at any time",
        "Pluggable providers: local / docker / e2b behind one interface"
      ]
    }
  ]
