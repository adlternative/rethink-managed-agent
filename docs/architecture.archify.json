  "cards": [
    {
      "dot": "cyan",
      "title": "API 层",
      "items": [
        "对齐 Claude Managed Agents：agents / environments / sessions / events",
        "SSE 先回放 DB 再订阅 Redis，按 seq 去重"
      ]
    },
    {
      "dot": "emerald",
      "title": "薄 Harness",
      "items": [
        "直接依赖 pi-agent-core 的 runAgentLoop，不重写 loop",
        "events 表是唯一真相，session 状态由折叠事件得到",
        "多 runner 副本靠 consumer group 和行锁分担"
      ]
    },
    {
      "dot": "violet",
      "title": "Sandbox 解耦",
      "items": [
        "session 不持有 sandbox，只在工具调用时懒租",
        "同一 workspace 的多个 session 通过 affinity 复用容器",
        "turn 结束 capture 到 Workspace 卷，sandbox 可随时销毁",
        "provider 可插拔：local / docker / e2b 同一接口"
      ]
    }
  ]
