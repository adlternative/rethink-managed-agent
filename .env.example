# Postgres (PolarDB is wire-compatible: just point DATABASE_URL at it)
DATABASE_URL=postgres://pi:pi@localhost:5432/pi
REDIS_URL=redis://localhost:6379
# Model providers. Qoder proxy = ~/qoder-openai-provider (OpenAI-compatible, port 4141)
QODER_BASE_URL=http://127.0.0.1:4141/v1
ANTHROPIC_API_KEY=
# The qoder proxy ignores auth; pi-ai still needs a non-empty bearer token, any value works.
#QODER_API_KEY=qoder
# Sandbox
SANDBOX_DEFAULT_PROVIDER=local   # local | docker | e2b
# e2b cloud sandboxes (https://e2b.dev): set the key to enable the e2b provider
E2B_API_KEY=
E2B_TEMPLATE=base
SANDBOX_LOCAL_ROOT=./data/sandboxes
# Only when the runner is itself a container and uses the docker provider: absolute host path of the
# directory mounted at SANDBOX_LOCAL_ROOT. docker compose defaults it to $PWD/data/sandboxes.
#SANDBOX_HOST_ROOT=
SANDBOX_IDLE_TTL_MS=600000
API_PORT=8080
# Host ports published by docker compose (change if something else already listens there)
#PG_HOST_PORT=5432
#REDIS_HOST_PORT=6379

# plugins: hostnames ctx.fetch may reach ("*" = any); EXPERIMENTAL_PI_PACKAGES=1 switches to the pi-coding-agent host
PLUGIN_FETCH_ALLOW=*
# docker sandboxes default to no egress; environments can opt into network=bridge and plugin_host=sandbox per environment
